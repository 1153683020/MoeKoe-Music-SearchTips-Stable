{
  "manifest_version": 3,
  "name": "搜索建议",
  "version": "1.0.0",
  "description": "在搜索框中输入关键词时，实时显示搜索建议和热度",
  "author": {
    "name": "AZLight",
    "url":"https://github.com/1153683020"
  },
  "moekoe": true,
  "plugin_id": "com.moekoe.search-suggest",
  "minversion": "1.6.0",
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "搜索建议"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}